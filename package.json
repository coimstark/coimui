{
  "name": "coimui-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:starter": "bun --filter @coimui/starter dev",
    "dev:showcase": "bun --filter @coimui/showcase dev",
    "package": "bun --filter @coimui/svelte package",
    "typecheck:ts7": "bun --filter @coimui/svelte typecheck:ts7",
    "check": "bun --filter @coimui/svelte package && bun --filter @coimui/svelte check && bun --filter @coimui/starter check && bun --filter @coimui/showcase check",
    "test:unit": "bun --filter @coimui/svelte test:unit",
    "build": "bun --filter @coimui/svelte package && bun --filter @coimui/starter build && bun --filter @coimui/showcase build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-npm-release.mjs",
    "test:parity": "playwright test --config=tests/visual-parity/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "jsdom": "31.0.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
