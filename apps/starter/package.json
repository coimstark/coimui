{
  "name": "@coimui/starter",
  "version": "1.0.0",
  "description": "CoimUI v1 starter admin application template built with Svelte 5 and SvelteKit 3",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 4175",
    "build": "vite build",
    "preview": "vite preview --port 4175",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@coimui/svelte": "workspace:*",
    "i18next": "27.2.3",
    "sveltekit-superforms": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
