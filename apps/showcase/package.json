{
  "name": "@coimui/showcase",
  "version": "1.0.0",
  "description": "CoimUI v1 showcase application, live component documentation, and administrative workflows",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
