    "@tanstack/svelte-virtual": "3.13.52",
    "d3-array": "3.2.5",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.18",
    "emoji-picker-element": "1.29.1",
    "exceljs": "4.4.0",
    "highlight.js": "11.12.0",
    "i18next": "27.2.3",
    "imask": "7.6.1",
    "layerchart": "2.11.0",
    "marked": "18.2.1",
